{
  "name": "muhasebe-saas",
  "version": "0.2.3",
  "private": true,
  "scripts": {
    "backup:preflight": "node --use-system-ca --import tsx scripts/backup/cli.ts preflight",
    "backup:create": "node --use-system-ca --import tsx scripts/backup/cli.ts create",
    "backup:upload": "node --use-system-ca --import tsx scripts/backup/cli.ts upload",
    "backup:verify": "node --use-system-ca --import tsx scripts/backup/cli.ts verify",
    "backup:list": "node --use-system-ca --import tsx scripts/backup/cli.ts list",
    "backup:test": "vitest run tests/backup.test.ts tests/backup-source.test.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "predev": "npm run db:generate",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:setup": "tsx scripts/db/setup.ts",
    "db:grants": "tsx scripts/db/setup.ts --grants",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:migrate:test": "tsx scripts/db/migrate.ts --test",
    "db:test": "node --conditions=react-server --import tsx scripts/db/verify.ts",
    "cloud:test": "node --conditions=react-server --import tsx scripts/auth/verify-d.ts",
    "auth:setup": "tsx scripts/auth/setup.ts",
    "auth:roles": "tsx scripts/auth/setup-authorization.ts",
    "auth:bootstrap": "node --conditions=react-server --import tsx scripts/auth/bootstrap.ts",
    "auth:test:c1": "node --conditions=react-server --import tsx scripts/auth/verify-c1.ts",
    "auth:test:c2": "node --conditions=react-server --import tsx scripts/auth/verify-c2.ts",
    "auth:test:c3": "node --conditions=react-server --import tsx scripts/auth/verify-c3.ts",
    "auth:test:c4": "node --conditions=react-server --import tsx scripts/auth/verify-c4.ts",
    "auth:test:c5": "node --conditions=react-server --import tsx scripts/auth/verify-c5.ts",
    "auth:test:c61": "node --conditions=react-server --import tsx scripts/auth/verify-c61.ts",
    "auth:test:c6": "node --conditions=react-server --import tsx scripts/auth/verify-c6.ts",
    "mail:test": "node --conditions=react-server --import tsx scripts/auth/mail-smoke.ts",
    "auth:test": "npm run auth:test:c1 && npm run auth:test:c2 && npm run auth:test:c3 && npm run auth:test:c4 && npm run auth:test:c5 && npm run auth:test:c6 && npm run auth:test:c61",
    "auth:prepare-browser": "node --conditions=react-server --import tsx scripts/auth/prepare-browser.ts",
    "test:e2e:auth": "npm run auth:prepare-browser && playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.3.0",
    "next": "^16.4.1",
    "pg": "8.23.1",
    "qrcode.react": "4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.3.0",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
