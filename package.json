{
  "name": "muhasebe-saas",
  "version": "0.2.3",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "predev": "npm run db:generate",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:setup": "tsx scripts/db/setup.ts",
    "db:grants": "tsx scripts/db/setup.ts --grants",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:migrate:test": "tsx scripts/db/migrate.ts --test",
    "db:test": "node --conditions=react-server --import tsx scripts/db/verify.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.3.0",
    "next": "^16.4.1",
    "pg": "8.23.1",
    "qrcode.react": "4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
