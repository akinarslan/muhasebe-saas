// Canonical017: RLS, deferred/immutable triggers, CHECK and NULLS NOT DISTINCT
// semantics remain SQL-owned. Partial indexes are represented with partialIndexes.
model FinanceAccount {
  id                                                                                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                                                                               String                 @db.Uuid
  legalEntityId                                                                          String                 @db.Uuid
  activityId                                                                             String?                @db.Uuid
  createdById                                                                            String
  kind                                                                                   String
  customerId                                                                             String?                @db.Uuid
  supplierId                                                                             String?                @db.Uuid
  currency                                                                               String                 @default("TRY")
  label                                                                                  String                 @default("") @db.VarChar(100)
  Activity                                                                               Activity?              @relation(fields: [tenantId, legalEntityId, activityId], references: [tenantId, legalEntityId, id], onDelete: NoAction, onUpdate: NoAction)
  Customer                                                                               Customer?              @relation(fields: [tenantId, legalEntityId, customerId], references: [tenantId, legalEntityId, id], onDelete: NoAction, onUpdate: NoAction)
  LegalEntity                                                                            LegalEntity            @relation(fields: [tenantId, legalEntityId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  Supplier                                                                               Supplier?              @relation(fields: [tenantId, legalEntityId, supplierId], references: [tenantId, legalEntityId, id], onDelete: NoAction, onUpdate: NoAction)
  FinanceAccountAccess                                                                   FinanceAccountAccess[]
  FinanceFundMovement                                                                    FinanceFundMovement[]
  FinanceJournal                                                                         FinanceJournal[]
  FinanceOperation_FinanceOperation_tenantId_legalEntityId_accountIdToFinanceAccount     FinanceOperation[]     @relation("FinanceOperation_tenantId_legalEntityId_accountIdToFinanceAccount")
  FinanceOperation_FinanceOperation_tenantId_legalEntityId_fundAccountIdToFinanceAccount FinanceOperation[]     @relation("FinanceOperation_tenantId_legalEntityId_fundAccountIdToFinanceAccount")
  FinancePosting                                                                         FinancePosting[]

  @@unique([tenantId, legalEntityId, activityId, kind, customerId, supplierId])
  @@unique([tenantId, legalEntityId, id])
}

model FinanceAccountAccess {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @db.Uuid
  legalEntityId  String         @db.Uuid
