  FinanceJournal   FinanceJournal   @relation(fields: [tenantId, legalEntityId, sourceJournalId], references: [tenantId, legalEntityId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sourceJournalId], map: "finance_allocation_source")
}

