generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CostUnit {
  square_meter
  linear_meter
  piece
  sheet
}

model Tenant {
  id       String        @id @default(uuid()) @db.Uuid
  name     String        @db.VarChar(200)
  memberships Membership[]
  entities LegalEntity[]
}

model LegalEntity {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  name       String     @db.VarChar(200)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  activities Activity[]
  customers  Customer[]
  materials  Material[]

  @@unique([tenantId, id])
}

model Activity {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  legalEntityId String      @db.Uuid
  name          String      @db.VarChar(100)
  entity        LegalEntity @relation(fields: [tenantId, legalEntityId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, legalEntityId, id])
}

model Customer {
  payloadHash String?
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  legalEntityId String      @db.Uuid
  activityId    String? @db.Uuid
  createdById   String?
  sourceId      String      @db.VarChar(200)
  name          String      @db.VarChar(200)
  email         String?     @db.VarChar(320)
  active Boolean @default(true)
  segment String @default("Mağaza-İşyeri")
  city String @default("")
  district String @default("")
  phone String @default("")
  taxOffice String @default("")
  taxId String @default("")
  contact String @default("")
  address String @default("")
  notes String @default("")
  term Int @default(30)
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  entity        LegalEntity @relation(fields: [tenantId, legalEntityId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, legalEntityId, id])
  @@unique([tenantId, legalEntityId, sourceId])
  @@index([tenantId, legalEntityId, name])
}

model Material {
  payloadHash String?
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  legalEntityId String            @db.Uuid
  name          String            @db.VarChar(200)
  sourceId String?
  category String @default("")
  brand String @default("")
  supplierReference String @default("")
  sku String @default("")
  description String @default("")
  active Boolean @default(true)
  vat Decimal @default(20) @db.Decimal(8,4)
  margins Json @default("{}")
  version Int @default(1)
  unit          CostUnit
  activityId    String? @db.Uuid
  createdById   String?
  roll          Boolean           @default(false)
  entity        LegalEntity       @relation(fields: [tenantId, legalEntityId], references: [tenantId, id], onDelete: Restrict)
  variants      MaterialVariant[]
  @@unique([tenantId,legalEntityId,sourceId])

  @@unique([tenantId, legalEntityId, id])
}

model MaterialVariant {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @db.Uuid
  legalEntityId String                 @db.Uuid
  materialId    String                 @db.Uuid
  name          String                 @db.VarChar(200)
  widthCm       Decimal                @db.Decimal(12, 4)
  lengthCm      Decimal?               @db.Decimal(12, 4)
  usdCost       Decimal?               @db.Decimal(18, 6)
  active Boolean @default(true)
  priceVersion Int @default(1)
  inStock       Boolean                @default(false)
  material      Material               @relation(fields: [tenantId, legalEntityId, materialId], references: [tenantId, legalEntityId, id], onDelete: Restrict)
  history       MaterialPriceHistory[]

  @@unique([tenantId, legalEntityId, id])
}

model MaterialPriceHistory {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  legalEntityId String          @db.Uuid
  variantId     String          @db.Uuid
  previousUsd   Decimal?        @db.Decimal(18, 6)
  nextUsd       Decimal         @db.Decimal(18, 6)
  actorId       String          @db.VarChar(200)
  recordedAt    DateTime        @default(now()) @db.Timestamptz(3)
  variant       MaterialVariant @relation(fields: [tenantId, legalEntityId, variantId], references: [tenantId, legalEntityId, id], onDelete: Restrict)

  @@index([tenantId, legalEntityId, variantId, recordedAt])
}

// Authentication storage is isolated from business runtime grants.
model AuthUser {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  lastLoginAt DateTime? @db.Timestamptz(3)
  twoFactorEnabled Boolean @default(false)
  memberships Membership[]
  twoFactor AuthTwoFactor?
  sessions AuthSession[]
  accounts AuthAccount[]
}
model AuthSession {
  id String @id
  mfaVerifiedAt DateTime? @db.Timestamptz(3)
  stepUpAt DateTime? @db.Timestamptz(3)
  token String @unique
  userId String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  user AuthUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId])
}
model AuthAccount {
  id String @id
  accountId String
  providerId String
  userId String
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope String?
  password String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user AuthUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId])
  @@unique([providerId,accountId])
}
model AuthVerification {
  id String @id
  identifier String
  value String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([identifier])
}
model AuthRateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
}

model AuthTwoFactor {
  id String @id
  userId String @unique
  secret String
  backupCodes String
  verified Boolean @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  user AuthUser @relation(fields:[userId], references:[id], onDelete:Cascade)
}
model AuthBootstrap {
  id String @id
  userId String @unique
  tenantId String @db.Uuid
  legalEntityId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model AuthSecurityEvent {
  id String @id @default(uuid())
  userId String
  action String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

enum ScopeKind {
  OWN
  ACTIVITY
  LEGAL_ENTITY
  TENANT
}
enum PermissionEffect {
  ALLOW
  DENY
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId String
  status String @default("ACTIVE")
  isMaster Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  user AuthUser @relation(fields:[userId],references:[id],onDelete:Restrict)
  roles RoleAssignment[]
  overrides UserPermissionOverride[]
  @@unique([tenantId,userId])
  @@unique([tenantId,id])
  @@index([userId,status])
}
model Role {
  id String @id
  name String
  permissions RolePermission[]
  assignments RoleAssignment[]
}
model Permission {
  id String @id
  label String
  module String
  roles RolePermission[]
  overrides UserPermissionOverride[]
}
model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields:[roleId],references:[id],onDelete:Restrict)
  permission Permission @relation(fields:[permissionId],references:[id],onDelete:Restrict)
  @@id([roleId,permissionId])
}
model PermissionScope {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  kind ScopeKind
  legalEntityId String? @db.Uuid
  activityId String? @db.Uuid
  department String?
  amountLimit Decimal? @db.Decimal(18,6)
  requiresApproval Boolean @default(false)
  roles RoleAssignment[]
  overrides UserPermissionOverride[]
  @@unique([tenantId,id])
}
model RoleAssignment {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  membershipId String @db.Uuid
  roleId String
  scopeId String @db.Uuid
  member Membership @relation(fields:[tenantId,membershipId],references:[tenantId,id],onDelete:Restrict)
  role Role @relation(fields:[roleId],references:[id],onDelete:Restrict)
  scope PermissionScope @relation(fields:[tenantId,scopeId],references:[tenantId,id],onDelete:Restrict)
  @@unique([membershipId,roleId,scopeId])
  @@index([tenantId,membershipId])
}
model UserPermissionOverride {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  membershipId String @db.Uuid
  permissionId String
  scopeId String @db.Uuid
  effect PermissionEffect
  member Membership @relation(fields:[tenantId,membershipId],references:[tenantId,id],onDelete:Restrict)
  permission Permission @relation(fields:[permissionId],references:[id],onDelete:Restrict)
  scope PermissionScope @relation(fields:[tenantId,scopeId],references:[tenantId,id],onDelete:Restrict)
  @@unique([membershipId,permissionId,scopeId])
  @@index([tenantId,membershipId])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  legalEntityId String? @db.Uuid
  actorId String
  targetId String
  action String
  summary Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([tenantId,targetId,createdAt])
}

model AuthInvitation {
 id String @id @default(uuid())
 tokenHash String @unique
 userId String
 membershipId String @db.Uuid
 tenantId String @db.Uuid
 expiresAt DateTime @db.Timestamptz(3)
 revokedAt DateTime? @db.Timestamptz(3)
 acceptedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([userId])
}

model TenantExchangeRate {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 actorId String
 usdTry Decimal @db.Decimal(18,6)
 reason String @db.VarChar(500)
 publishedAt DateTime @db.Date
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([tenantId,createdAt])
}

model AuthMailDelivery {
 id String @id @default(uuid())
 userId String
 membershipId String? @db.Uuid
 kind String
 provider String
 status String
 errorCode String?
 providerMessageId String?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([userId,createdAt])
}

model CloudProduct {
  payloadHash String?
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 legalEntityId String @db.Uuid
 activityId String? @db.Uuid
 createdById String
 sourceId String
 name String @db.VarChar(200)
 category String @default("")
 unit String
 kind String
 active Boolean @default(true)
 version Int @default(1)
 @@unique([tenantId,legalEntityId,id])
 @@unique([tenantId,legalEntityId,sourceId])
}
model CloudExpenseType {
 sourceId String?
 payloadHash String?
 @@unique([tenantId,legalEntityId,sourceId])
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 legalEntityId String @db.Uuid
 activityId String? @db.Uuid
 createdById String
 name String
 unit String
 usdAmount Decimal @db.Decimal(18,6)
 active Boolean @default(true)
 version Int @default(1)
 @@unique([tenantId,legalEntityId,id])
}
model CloudQuote {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 legalEntityId String @db.Uuid
 activityId String? @db.Uuid
 createdById String
 customerId String @db.Uuid
 groupId String @db.Uuid
 revision Int
 title String
 idempotencyKey String @db.Uuid
 payloadHash String
 snapshot Json
 netUsd Decimal @db.Decimal(18,6)
 costUsd Decimal @db.Decimal(18,6)
 netTry Decimal @db.Decimal(18,2)
 vatTry Decimal @db.Decimal(18,2)
 totalTry Decimal @db.Decimal(18,2)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([tenantId,legalEntityId,id])
 @@unique([tenantId,legalEntityId,groupId,revision])
 @@unique([tenantId,legalEntityId,idempotencyKey])
 @@index([tenantId,legalEntityId,createdAt])
}
model CloudSale {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 legalEntityId String @db.Uuid
 activityId String? @db.Uuid
 createdById String
 customerId String @db.Uuid
 idempotencyKey String @db.Uuid
 payloadHash String
 date DateTime @db.Date
 dueDate DateTime @db.Date
 currency String
 notes String
 rateSnapshot Json
 costUsd Decimal @db.Decimal(18,6)
 netUsd Decimal @db.Decimal(18,6)
 netTry Decimal @db.Decimal(18,2)
 vatTry Decimal @db.Decimal(18,2)
 totalTry Decimal @db.Decimal(18,2)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 lines CloudSaleLine[]
 plans CloudPaymentPlan[]
 @@unique([tenantId,legalEntityId,id])
 @@unique([tenantId,legalEntityId,idempotencyKey])
 @@index([tenantId,legalEntityId,date])
}
model CloudSaleLine {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 legalEntityId String @db.Uuid
 saleId String @db.Uuid
 productId String @db.Uuid
 description String
 quantity Decimal @db.Decimal(18,6)
 widthCm Decimal @db.Decimal(12,4)
 heightCm Decimal @db.Decimal(12,4)
 discount Decimal @db.Decimal(8,4)
 vat Decimal @db.Decimal(8,4)
 snapshot Json
 costUsd Decimal @db.Decimal(18,6)
 netUsd Decimal @db.Decimal(18,6)
 netTry Decimal @db.Decimal(18,2)
 vatTry Decimal @db.Decimal(18,2)
 totalTry Decimal @db.Decimal(18,2)
 sale CloudSale @relation(fields:[tenantId,legalEntityId,saleId],references:[tenantId,legalEntityId,id],onDelete:Restrict)
 @@index([tenantId,legalEntityId,saleId])
}
model CloudPaymentPlan {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 legalEntityId String @db.Uuid
 saleId String @db.Uuid
 dueDate DateTime @db.Date
 method String
 amount Decimal @db.Decimal(18,2)
 sale CloudSale @relation(fields:[tenantId,legalEntityId,saleId],references:[tenantId,legalEntityId,id],onDelete:Restrict)
 @@index([tenantId,legalEntityId,saleId])
}
model CloudImportBatch {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 legalEntityId String @db.Uuid
 activityId String? @db.Uuid
 createdById String
 fileHash String
 status String
 preview Json
 reconciliation Json?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([tenantId,legalEntityId,fileHash])
 @@unique([tenantId,legalEntityId,id])
}
model CloudImportRecord {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 legalEntityId String @db.Uuid
 activityId String? @db.Uuid
 createdById String
 batchId String @db.Uuid
 kind String
 sourceId String
 targetId String @db.Uuid
 @@unique([tenantId,legalEntityId,kind,sourceId])
}
