# All credentials are server-only; never use NEXT_PUBLIC_ for these keys.
# Only the approved Neon development branch is allowed by current target guards.
DATABASE_URL=
DIRECT_DATABASE_URL=
DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=
TEST_DIRECT_DATABASE_URL=
NEON_BRANCH=development

# Separate restricted auth role, generated by npm run auth:setup.
AUTH_DATABASE_URL=
TEST_AUTH_DATABASE_URL=
AUTH_SECRET=
AUTH_TEST_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000

# Legacy PUSULA_RATE_ADMIN_TOKEN no longer authorizes manual mutations.
# TCMB GET remains public. Manual writes use real session + permissions + step-up.
# Server-only Resend. Test mode only sends to the account-approved verified recipient.
# Without a key the development-only encrypted local carrier remains available.
AUTH_MAIL_PROVIDER=local
AUTH_MAIL_MODE=test
RESEND_API_KEY=
RESEND_TEST_RECIPIENT=
RESEND_FROM=
AUTH_PUBLIC_URL=http://127.0.0.1:3000
# Explicit opt-in for action links to the developer's own running app; never production.
AUTH_MAIL_ALLOW_LOCAL_LINKS=false

# Sprint E2 operator CLI only; never imported by application/browser.
# Server/operator only. Preserve real .env.local; never use NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pusula-backups-development
R2_ENDPOINT=
# Direct/unpooled verified TLS; separate reviewed backup identity.
BACKUP_SOURCE_DATABASE_URL=
# Separate EMPTY isolated explicitly approved restore target; never existing dev/test.
BACKUP_RESTORE_TEST_DATABASE_URL=
# Canonical base64 of 32 cryptographically random bytes. Operator approval required.
# Never generate a real key into this example, stdout, Git or R2.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_ID=
# Optional PostgreSQL18 bin directory (otherwise PATH/standard Windows directory).
BACKUP_PG_BIN=
# Optional verified CA PEM for libpq; never disable verify-full.
BACKUP_PG_SSLROOTCERT=
# Optional local-only synthetic fixture; exact loopback/DB/role guard applies.
BACKUP_FIXTURE_DATABASE_URL=
# Optional separate read-only Cloudflare control-plane token for public-domain audit.
# Not the S3 Access Key; does not itself prove S3 key bucket scope.
CLOUDFLARE_API_TOKEN=
