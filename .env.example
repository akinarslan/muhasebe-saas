# Manuel USD/TRY girişi için en az 24 karakterlik benzersiz bir yönetici anahtarı.
# Boşsa manuel kur endpoint'i kapalıdır. Anahtar tarayıcıda saklanmaz.
PUSULA_RATE_ADMIN_TOKEN=
PUSULA_RATE_ADMIN_NAME=Yerel yönetici

# v0.3 Sprint B: server-only DB temeli. Auth/bulut UI henüz uygulanmadı.
# Aşağıdaki değerler yalnız sunucu içindir; NEXT_PUBLIC_ öneki kullanmayın.
# İlk bağlantı yalnız boş geliştirme/staging Neon projesine yapılacak.
# Connect > Connection pooling ON: uygulama için pooled URL.
DATABASE_URL=
# Connect > Connection pooling OFF: migration / pg_dump için direct URL.
DIRECT_DATABASE_URL=
# Neon init creates this alias; it must also target the development database.
DATABASE_URL_UNPOOLED=
# Separate empty database on the development branch; never production.
TEST_DATABASE_URL=
TEST_DIRECT_DATABASE_URL=
NEON_BRANCH=development
# Uygulamanın yönettiği Better Auth için en az 32 rastgele byte.
# Managed Neon Auth seçilmedi: zorunlu Master Admin MFA henüz desteklenmiyor.
AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
